# ==============================================================================
# CSMS V2 Production Environment Variables for Google Cloud VM + Supabase
# ==============================================================================

APP_NAME="CSMS V2"
DEBUG=False

# Supabase PostgreSQL connection string (Session Pooler mode - port 5432)
# Replace [PROJECT_REF], [DB_PASSWORD], and [REGION] with your Supabase credentials:
# Example: postgresql+asyncpg://postgres.abcdefghijklmno:YourPassword123@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cryptographic Secret Key for JWT Authentication (generate via: openssl rand -hex 32)
JWT_SECRET_KEY="generate-a-secure-random-hex-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
